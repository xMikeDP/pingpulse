generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MonitorStatus {
  OPERATIONAL
  DEGRADED
  DOWN
  PAUSED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  monitors     Monitor[]
}

model Monitor {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  url            String
  method         String        @default("GET") // GET or HEAD
  intervalSec    Int           @default(300)   // e.g., 60, 300, 900
  expectedStatus Int           @default(200)
  status         MonitorStatus @default(OPERATIONAL)
  isPaused       Boolean       @default(false)
  lastCheckedAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  pingLogs       PingLog[]
  incidents      Incident[]

  @@index([userId])
  @@index([isPaused, lastCheckedAt])
}

model PingLog {
  id           String   @id @default(uuid())
  monitorId    String
  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  statusCode   Int?     // Null if network error or timeout
  latencyMs    Int
  isSuccess    Boolean
  errorMessage String?
  checkedAt    DateTime @default(now())

  @@index([monitorId, checkedAt])
}

model Incident {
  id           String    @id @default(uuid())
  monitorId    String
  monitor      Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  reason       String    // e.g., "HTTP 500", "Timeout (>10000ms)", "DNS Error"
  startedAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([monitorId, startedAt])
}
